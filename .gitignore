frontend-app/.pub/
frontend-app/build/
frontend-app/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
frontend-app/android/app/debug
frontend-app/android/app/profile
frontend-app/android/app/release
frontend-app/android/.kotlin/

# Widget Preview related
frontend-app/.widget_preview/
