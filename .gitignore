#api app
# compiled output
backend-app/dist
backend-app/node_modules
backend-app/build

# Logs
backend-app/logs
backend-app/*.log
backend-app/npm-debug.log*
backend-app/pnpm-debug.log*
backend-app/yarn-debug.log*
backend-app/yarn-error.log*
backend-app/lerna-debug.log*

# Tests
backend-app/coverage
backend-app/.nyc_output

# dotenv environment variable files
backend-app/.env
backend-app/.env.development.local
backend-app/.env.test.local
backend-app/.env.production.local
backend-app/.env.local

# temp directory
backend-app/.temp
backend-app/.tmp

# Runtime data
backend-app/pids
backend-app/*.pid
backend-app/*.seed
backend-app/*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
backend-app/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


#flutter app
# Miscellaneous
frontend-app/*.class
frontend-app/*.log
frontend-app/*.pyc
frontend-app/*.swp
frontend-app/.DS_Store
frontend-app/.atom/
frontend-app/.build/
frontend-app/.buildlog/
